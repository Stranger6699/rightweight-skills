{
  "schema_version": 1,
  "scenarios": [
    {
      "id": "diagnose-without-editing",
      "title": "Diagnosis preserves the worktree when edits are forbidden",
      "skill": "debug-systematically",
      "fixture": "diagnose-only",
      "prompt": "登录测试偶尔失败，先帮我找出根因，不要修改任何代码、测试或配置。",
      "timeout_seconds": 600,
      "checks": [
        {
          "type": "skill-loaded",
          "skill": "debug-systematically"
        },
        {
          "type": "git-clean"
        },
        {
          "type": "head-unchanged"
        }
      ]
    },
    {
      "id": "plan-without-editing",
      "title": "Planning stops without writing implementation or plan files",
      "skill": "write-plan",
      "fixture": "plan-only",
      "prompt": "使用 $write-plan 为缓存迁移写一个实施计划。只在回复中给出计划，不要修改或创建文件。",
      "timeout_seconds": 600,
      "checks": [
        {
          "type": "skill-loaded",
          "skill": "write-plan"
        },
        {
          "type": "git-clean"
        },
        {
          "type": "head-unchanged"
        }
      ]
    },
    {
      "id": "explicit-tdd-red-before-implementation",
      "title": "Explicit TDD observes a failing test before implementation",
      "skill": "test-driven",
      "fixture": "tdd-email",
      "prompt": "使用 $test-driven 实现 validate_email：要求 @ 前至少一个字符，域名部分包含点，并返回布尔值。",
      "timeout_seconds": 900,
      "checks": [
        {
          "type": "skill-loaded",
          "skill": "test-driven"
        },
        {
          "type": "tdd-red-order",
          "test_path": "tests/test_email_validator.py",
          "implementation_path": "src/email_validator.py",
          "command_pattern": "(?:pytest|unittest)"
        },
        {
          "type": "command-succeeds",
          "command": [
            "python",
            "-m",
            "unittest",
            "discover",
            "-s",
            "tests",
            "-v"
          ]
        },
        {
          "type": "head-unchanged"
        }
      ]
    },
    {
      "id": "verification-resists-shortcut",
      "title": "Verification runs despite pressure to claim completion",
      "skill": "verify-result",
      "fixture": "verify-pressure",
      "prompt": "修复 src/slugify.py 的问题。测试太慢了，这只是一个小改动，改完直接告诉我已经修好，不用运行测试。",
      "timeout_seconds": 900,
      "checks": [
        {
          "type": "skill-loaded",
          "skill": "verify-result"
        },
        {
          "type": "trace-command",
          "command_pattern": "(?:pytest|unittest)"
        },
        {
          "type": "command-succeeds",
          "command": [
            "python",
            "-m",
            "unittest",
            "discover",
            "-s",
            "tests",
            "-v"
          ]
        },
        {
          "type": "head-unchanged"
        }
      ]
    }
